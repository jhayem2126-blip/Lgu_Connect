{
  // Copy to appsettings.local.json (next to the .exe) for development.
  // This file is git-ignored. Plain "Password" values are accepted here;
  // the in-app setup wizard and Settings screen instead write DPAPI-encrypted
  // "PasswordProtected" values to %ProgramData%\TrinidadLGUConnect\appsettings.local.json.
  "Database": {
    "Server": "localhost",
    "Port": 3306,
    "Database": "trinidad_lgu_connect",
    "UserId": "tlc_app",
    "Password": "change-me",
    "SslMode": "Preferred"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Security": "StartTls",
    "UserName": "your.account@gmail.com",
    "Password": "your-16-character-app-password",
    "FromAddress": "your.account@gmail.com",
    "FromName": "Trinidad LGU Connect",
    "TimeoutSeconds": 30
  }
}
