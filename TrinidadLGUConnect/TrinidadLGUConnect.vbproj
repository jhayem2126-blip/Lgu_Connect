<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TrinidadLGUConnect</RootNamespace>
    <AssemblyName>TrinidadLGUConnect</AssemblyName>
    <StartupObject>TrinidadLGUConnect.Program</StartupObject>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <OptionCompare>Binary</OptionCompare>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>DpiUnawareGdiScaled</ApplicationHighDpiMode>
    <Product>Trinidad LGU Connect</Product>
    <Company>Municipality of Trinidad, Bohol</Company>
    <Description>Community Concern Reporting and Monitoring System</Description>
    <Version>1.0.0</Version>
    <NeutralLanguage>en-PH</NeutralLanguage>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- WFO1000 concerns Visual Studio designer code serialization. Every form and control in this
         project is built in code (no *.Designer.vb files), so no property is ever serialized. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.IO" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="26.7.0" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <!-- Pinned to 6.2.x: the last MIT-licensed line. PDFsharp 6.5+ is AGPL-3.0 with a runtime license check. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Images are copied next to the executable so they can be replaced with higher-resolution originals without recompiling. -->
    <Content Include="Resources\Images\*.*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="appsettings.local.example.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\database\schema.sql" Link="Data\schema.sql" LogicalName="TrinidadLGUConnect.schema.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TrinidadLGUConnect.Tests" />
  </ItemGroup>

</Project>
